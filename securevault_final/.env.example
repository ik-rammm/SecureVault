# SecureVault — Environment Variables
# Copy to .env and change all values before any production deployment.

# Flask session signing key (32+ random chars)
SECRET_KEY=change-this-to-a-random-64-char-string

# RS256 JWT key pair (report §2.1). If these files do not exist they are
# auto-generated on first start. In production, provision them out-of-band.
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem

# Optional Redis (JWT blacklist + rate limiting). The app degrades gracefully
# to an in-memory blacklist if Redis is unavailable.
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=securevault_redis_pass

# SQLite data directory (vault blobs + security event journal)
DATA_DIR=securevault/data

# development | production
FLASK_ENV=production
